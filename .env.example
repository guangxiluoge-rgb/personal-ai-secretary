ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ai_secretary
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:5173

# Optional bootstrap for the first admin. After /api/admin/bootstrap, change/remove these.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# These are fallback values. Preferred: configure them in /admin after login.
ANTFU_API_URL=
ANTFU_API_KEY=
ANTFU_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_HEALTH_PRO_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# WeChat Pay: production credentials should be entered in /admin.
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=

# Alipay: production credentials should be entered in /admin.
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
